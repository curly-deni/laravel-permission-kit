{
    "name": "curly-deni/laravel-permission-kit",
    "description": "A unified Laravel toolkit for permission and policy management, combining multiple packages for controllers, policies, attributes, and scopes.",
    "keywords": [
        "laravel",
        "permissions",
        "authorization",
        "policy",
        "roles",
        "access control",
        "gate",
        "scopes",
        "controller",
        "middleware"
    ],
    "homepage": "https://github.com/curly-deni/laravel-permission-kit",
    "license": "MIT",
    "authors": [
        {
            "name": "Danila Mikhalev",
            "email": "danila@dan-mi.ru",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "curly-deni/laravel-permission-controller": "*",
        "curly-deni/laravel-permission-maker": "*",
        "curly-deni/laravel-permission-model-attributes": "*",
        "curly-deni/laravel-permission-policy": "*",
        "curly-deni/laravel-scopes": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14"
    },
    "autoload": {
        "psr-4": {
            "Aesis\\PermissionKit\\": "src/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aesis\\PermissionKit\\PermissionKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
